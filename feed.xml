---
layout: null
permalink: /feed.xml
---
{% assign discovery = site.data.neutriverse_discovery.feed %}
{% assign visible_posts = site.posts | where_exp: 'item', 'item.hidden != true' %}
{% assign fragment_page = site.tabs | where: 'layout', 'thoughts' | first %}
{% assign fragments = '' | split: '' %}
{% if discovery.include_fragments and fragment_page and fragment_page.fragments %}
  {% assign fragments = fragment_page.fragments %}
{% endif %}
{% assign writings = visible_posts | concat: fragments | sort: 'date' | reverse %}
{% assign entries = writings | slice: 0, discovery.limit %}
{% assign latest = entries | first %}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <updated>{{ latest.date | date_to_xmlschema }}</updated>
  <link rel="self" type="application/atom+xml" href="{{ discovery.path | absolute_url | xml_escape }}"/>
  <link rel="alternate" type="text/html" href="{{ '/' | absolute_url | xml_escape }}"/>
  <author>
    <name>{{ site.social.name | default: site.title | xml_escape }}</name>
    <uri>{{ '/' | absolute_url | xml_escape }}</uri>
  </author>
  <generator uri="https://jekyllrb.com/">Jekyll</generator>
  {% for entry in entries %}
    {% assign is_fragment = false %}
    {% if entry.type == 'fragment' and entry.text %}
      {% assign is_fragment = true %}
    {% endif %}
    {% if is_fragment %}
      {% capture entry_title %}Fragment · {{ entry.date | date: '%Y-%m-%d' }}{% endcapture %}
      {% capture entry_path %}{{ fragment_page.url }}#{{ entry.id }}{% endcapture %}
      {% assign entry_summary = entry.text %}
    {% else %}
      {% assign entry_title = entry.title %}
      {% assign entry_path = entry.url %}
      {% assign entry_summary = entry.description | default: entry.excerpt | default: entry.content | strip_html | strip_newlines %}
    {% endif %}
  <entry>
    <id>{{ entry_path | absolute_url | xml_escape }}</id>
    <title>{{ entry_title | strip | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ entry_path | absolute_url | xml_escape }}"/>
    <published>{{ entry.date | date_to_xmlschema }}</published>
    <updated>{{ entry.date | date_to_xmlschema }}</updated>
    <category term="{{ entry.type | default: 'note' | xml_escape }}"/>
    {% if entry.topic %}<category term="{{ entry.topic | xml_escape }}"/>{% endif %}
    <summary type="html">{{ entry_summary | strip | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
